/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing DIA-NN 2.5.1 (PXD049412)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

*/

process {
    resourceLimits = [
        cpus: 18,
        memory: '96.GB',
        time: '90.h'
    ]

    withLabel: 'diann' {
        container = 'ghcr.io/bigbio/diann:2.5.1'
    }
}

params {
    config_profile_name        = 'Testing DIA-NN 2.5.1 (PXD049412)'
    config_profile_description = 'Test PXD049412 with DIA-NN 2.5.1'

    outdir = './results_PXD049412'

    // Input data
    input = '/home/yueqx/Data_Disk/proteogenomics/quantmsdiann/tests/data_test/benchmarks/ProteoBench/PXD049412/sdrf/PXD049412_local.sdrf.tsv'
    database = '/home/yueqx/Data_Disk/proteogenomics/quantmsdiann/tests/data_test/benchmarks/ProteoBench/PXD049412/fasta/ProteoBenchFASTA_DDAQuantification_noecoli.fasta'

    min_pr_mz = 400
    max_pr_mz = 800
    min_fr_mz = 200
    max_fr_mz = 1800
    min_peptide_length = 7
    max_peptide_length = 30
    max_precursor_charge = 4
    allowed_missed_cleavages = 2
    normalize = false
    publish_dir_mode = 'symlink'
    max_mods = 2
    quantums = false

    diann_version = '2.5.1'
}

singularity.enabled = false
docker.enabled = true
