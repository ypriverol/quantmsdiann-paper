// Per-process resource overrides auto-loaded by run_local.sh via -c.
//
// Scales heavy DIA-NN steps with mzML count so very large DIA datasets
// don't OOM. Mirrors the pattern used for ASSEMBLE_EMPIRICAL_LIBRARY in
// quantmsdiann's conf/pride_codon_slurm.config.

process {

    // In-silico library generation runs the DIA-NN predictor and is the
    // most thread-hungry step. Default label `process_medium` is 8 cpu /
    // 36 GB; full human SwissProt + isoforms + entrap + contaminants needs
    // ~120-200 GB to predict at DIA-NN 2.5 quality settings.
    withName: 'INSILICO_LIBRARY_GENERATION' {
        cpus   = { 24     * task.attempt }
        memory = { 150.GB * task.attempt }
        time   = { 12.h   * task.attempt }
    }

    // Final DIA-NN summarize/quant step. Loads every per-file .quant and
    // builds the precursor/protein matrices in memory; peak RAM grows with
    // the number of runs. On PXD030304 (5798 mzML) this OOM'd at 72 -> 144
    // -> 216 GB and gave up: the old `(ms_files as List).size()` tiering
    // collapsed to size 1 (so the 5798-file dataset hit the <200 tier), and
    // even the intended 400 GB tier exceeds what a `standard` node can hold.
    //
    // Fix: don't depend on the (unreliable) ms_files count. Escalate memory
    // purely by attempt. IMPORTANT: do NOT set `queue` — on Codon, pst_prd is
    // forbidden from naming the `bigmem` partition directly ("Specifying
    // bigmem partition is not allowed, please use --mem"). The cluster's
    // job_submit plugin auto-routes a high `--mem` request onto a 2 TB bigmem
    // node, so we just ask for the memory and let SLURM place it.
    //   attempt 1 -> 200 GB   (cheap; stays on standard, fits normal datasets)
    //   attempt 2 -> 600 GB    (auto-routed to bigmem)
    //   attempt 3 -> 1100 GB
    //   attempt 4 -> 1700 GB   (headroom on the ~1.98 TB nodes)
    // OOM exit codes force the retry; anything else fails fast.
    withName: 'FINAL_QUANTIFICATION' {
        errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
        maxRetries    = 4
        cpus   = { task.attempt == 1 ? 24 : 48 }
        memory = { task.attempt == 1 ? 200.GB :
                   [600.GB, 1100.GB, 1700.GB][ Math.min(task.attempt - 2, 2) ] }
        time   = { task.attempt == 1 ? 36.h : 72.h }
    }
}
