/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing DIA-NN 2.5.1 (PXD070049)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

*/

process {
    resourceLimits = [
        cpus: 18,
        memory: '96.GB',
        time: '90.h'
    ]

    withLabel: 'diann' {
        container = 'ghcr.io/bigbio/diann:2.5.1'
    }
}

params {
    config_profile_name        = 'Testing DIA-NN 2.5.1 (PXD070049)'
    config_profile_description = 'Test PXD070049 with DIA-NN 2.5.1'

    outdir = './results_PXD070049'

    // Input data
    input = '/home/yueqx/Data_Disk/proteogenomics/quantmsdiann/tests/data_test/benchmarks/ProteoBench/PXD070049/sdrf/PXD070049_local.sdrf.tsv'
    database = '/home/yueqx/Data_Disk/proteogenomics/quantmsdiann/tests/data_test/benchmarks/ProteoBench/PXD070049/fasta/ProteoBenchFASTA_MixedSpecies_HYE.fasta'

    min_fr_mz = 200
    max_fr_mz = 1800
    min_peptide_length = 7
    max_peptide_length = 30
    max_precursor_charge = 4
    allowed_missed_cleavages = 2
    // normalize = false
    publish_dir_mode = 'symlink'
    max_mods = 2
    quantums = false
    local_input_type = 'wiff'

    diann_version = '2.5.1'
}

singularity.enabled = false
docker.enabled = true
