process {
    executor = 'local'
    resourceLimits = [ cpus: 32, memory: '120.GB', time: '48.h' ]
    withLabel: 'diann' { container = '/hps/nobackup/juan/pride/reanalysis/singularity/ghcr.io-bigbio-diann-2.5.0.img' }
    withName: '.*(INSILICO_LIBRARY_GENERATION|PRELIMINARY_ANALYSIS|ASSEMBLE_EMPIRICAL_LIBRARY|INDIVIDUAL_ANALYSIS|FINAL_QUANTIFICATION)' { cpus = 16; memory = '56.GB' }
}
singularity { enabled = true; autoMounts = true; runOptions = '-B /hps' }
docker.enabled = false
